<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WallpaperScheduler.App</RootNamespace>
    <AssemblyName>WallpaperScheduler</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\WallpaperScheduler.Package\Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\WallpaperScheduler.Package\Assets\AppIcon.ico" Link="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WallpaperScheduler.Core\WallpaperScheduler.Core.csproj" />
    <ProjectReference Include="..\WallpaperScheduler.Agent\WallpaperScheduler.Agent.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Ship the background agent next to the app so the UI can start it. -->
  <Target Name="CopyAgent" AfterTargets="Build">
    <ItemGroup>
      <AgentFiles Include="..\WallpaperScheduler.Agent\bin\$(Configuration)\net10.0-windows10.0.19041.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentFiles)" DestinationFiles="@(AgentFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>

