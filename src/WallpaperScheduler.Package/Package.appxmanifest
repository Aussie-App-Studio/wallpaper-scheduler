<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="AussieAppStudio.WallpaperSchedulerTimeofDay"
    Publisher="CN=3BEDA7A9-55A1-4DF0-B246-12957BCB1FD1"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Wallpaper Scheduler: Time of Day</DisplayName>
    <PublisherDisplayName>Aussie App Studio</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="WallpaperScheduler.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Wallpaper Scheduler: Time of Day"
        Description="Automatically switch wallpapers and Windows Light/Dark theme by time of day or sunrise and sunset. No ads, no tracking, works offline."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="WallpaperSchedulerAgent.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="WallpaperSchedulerStartup" Enabled="true" DisplayName="Wallpaper Scheduler Background Agent" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <!-- Only runFullTrust is requested (needed for desktop wallpaper COM and theme personalization). No internet capability. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
